opam-version: "2.0"
maintainer: "Romain Beauxis <toots@rastageeks.org>"
authors: "Romain Beauxis <toots@rastageeks.org>"
homepage: "https://github.com/ocaml-cross/opam-cross-android"
bug-reports: "https://github.com/ocaml-cross/opam-cross-android/issues"
dev-repo: "git+https://github.com/ocaml-cross/opam-cross-android.git"
license: "MIT"
synopsis: "Virtual package relying on a GMP built for Android targets"
description: """
Detection only, mirroring the native conf-gmp.

build-gmp-android is an optional dependency rather than a required one: install
it to have this repository build GMP into the sysroot, or put your own there and
leave it out."""
flags: conf
depends: ["conf-ndk-android" "build-android-sysroot"]
depopts: ["build-gmp-android"]
build: [
  ["%{bin}%/android-cross-detect"
   "%{build-android-sysroot:prefix}%"
   "%{conf-ndk-android:prefix}%clang"
   "gmp" "-lgmp" "conf-gmp-android.config"]
]
extra-files: [
  ["test.c" "sha256=f024fbba815ac759edcd7f0b7998acb48458cabfbdb754859f8e8e4ec99ee5c6"]
]
