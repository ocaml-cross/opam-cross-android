opam-version: "2.0"
maintainer: "Romain Beauxis <toots@rastageeks.org>"
authors: "Romain Beauxis <toots@rastageeks.org>"
homepage: "https://github.com/ocaml-cross/opam-cross-android"
bug-reports: "https://github.com/ocaml-cross/opam-cross-android/issues"
dev-repo: "git+https://github.com/ocaml-cross/opam-cross-android.git"
license: "MIT"
synopsis: "Location of the Android cross sysroot"
description: """
Where cross-compiled C libraries live, declared once.

Some OCaml packages bind a C library that has to exist for the target before
they will build. Every build-<lib> installs into this prefix and every conf-<lib>
looks in it, so the layout is stated here rather than restated in each package.

The location is fixed at `$(opam var prefix)/android-sysroot`: that is where dune
puts anything cross-installed, and everything else is aligned to it so the OCaml
packages and the C libraries end up in the same tree."""
depends: ["conf-ndk-android"]
substs: ["build-android-sysroot.config"]
install: [
  # Creating these in build: would be denied — opam sandboxes the build phase
  # away from anything outside the build directory.
  ["sh" "-exc" "mkdir -p %{prefix}%/android-sysroot/lib/pkgconfig %{prefix}%/android-sysroot/include"]
  # Shared by the conf-<lib> packages, so each is a test.c and one command.
  ["install" "-m" "0755" "android-cross-detect" "%{bin}%/android-cross-detect"]
]
remove: [["rm" "-f" "%{bin}%/android-cross-detect"]]
extra-files: [
  ["android-cross-detect" "sha256=d4d7f42fa592014fb2702788ed6163aa912bd67962e865f9f1809a2bbf695bbe"]
  ["build-android-sysroot.config.in" "sha256=1014a62498ea6a4dc592cb7df9bb61b40a6f7fa42d4066da52d79e0599aa0767"]
]
