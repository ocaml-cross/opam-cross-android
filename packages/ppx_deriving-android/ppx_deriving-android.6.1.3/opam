opam-version: "2.0"
synopsis: "Type-driven code generation for OCaml"
maintainer: "Romain Beauxis <toots@rastageeks.org>"
license: "MIT"
homepage: "https://github.com/ocaml-ppx/ppx_deriving"
bug-reports: "https://github.com/ocaml-ppx/ppx_deriving/issues"
depends: [
  # Built in the native context as well: dune runs the ppx here.
  "cppo" {build}
  "ocamlfind"
  "ppx_derivers"
  "ppxlib"
  "ocaml-android"
  "dune" {>= "3.11.0"}
  "ppx_derivers-android"
  "ppxlib-android" {>= "0.36.0"}
]
dev-repo: "git+https://github.com/ocaml-ppx/ppx_deriving.git"
build: [
  # The standalone driver needs findlib.dynload, which a cross target lacks;
  # nothing built with dune uses it.
  ["sh" "-c" ": > src/dune"]
  ["dune" "build" "-p" "ppx_deriving" "-j" jobs "-x" "android" "@install"]
  ["rm" "%{name}%.install"]
]
install: ["dune" "install" "-x" "android" "-p" "ppx_deriving"]
