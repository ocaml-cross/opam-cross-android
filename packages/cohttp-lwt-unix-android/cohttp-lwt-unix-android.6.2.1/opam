doc: "https://mirage.github.io/ocaml-cohttp/"
bug-reports: "https://github.com/mirage/ocaml-cohttp/issues"
depends: [
  # Built in the native context as well: dune runs the ppx here.
  "ppx_sexp_conv"
  "dune" {>= "3.8"}
  "ocaml-android"
  "http-android" {= version}
  "cohttp-android" {= version}
  "cohttp-lwt-android" {= version}
  "cmdliner-android" {>= "2.0.0"}
  "lwt-android" {>= "3.0.0"}
  "conduit-lwt-android" {>= "7.1.0"}
  "conduit-lwt-unix-android" {>= "7.1.0"}
