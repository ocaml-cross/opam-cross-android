  "magic-mime-android"
  "logs-android"
]

dev-repo: "git+https://github.com/mirage/ocaml-cohttp.git"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" "cohttp-lwt-unix" "-j" jobs "-x" "android" "@install"]
  ["rm" "%{name}%.install"]
]
install: ["dune" "install" "-x" "android" "-p" "cohttp-lwt-unix"]
remove: ["ocamlfind" "-toolchain" "android" "remove" "cohttp-lwt-unix"]

