opam-version: "2.0"
synopsis: "OCaml Format pretty-printer combinators"
description: """\
Fmt exposes combinators to devise `Format` pretty-printing functions.

Fmt depends only on the OCaml standard library. The optional `Fmt_tty`
library that allows to setup formatters for terminal color output
depends on the Unix library. The optional `Fmt_cli` library that
provides command line support for Fmt depends on [`cmdliner`].

Fmt is distributed under the ISC license.

Home page: <http://erratique.ch/software/fmt>

[`cmdliner`]: http://erratique.ch/software/cmdliner"""
maintainer: "Daniel Bünzli <daniel.buenzl i@erratique.ch>"
authors: "The fmt programmers"
license: "ISC"
tags: ["string" "format" "pretty-print" "org:erratique"]
homepage: "https://erratique.ch/software/fmt"
doc: "https://erratique.ch/software/fmt/doc/"
bug-reports: "https://github.com/dbuenzli/fmt/issues"
depends: [
  "opam-installer" {build}
  "cmdliner-android"
  "ocaml-android"
  "ocamlfind" {build}
  "ocamlbuild" {build}
  "topkg" {build & >= "1.1.0"}
]
conflicts: [
  "cmdliner-android" {< "1.3.0"}
]

dev-repo: "git+https://erratique.ch/repos/fmt.git"
build: [["ocaml" "pkg/pkg.ml" "build" "--toolchain" "android"
         "--with-base-unix" "true"
         "--with-cmdliner" "%{cmdliner-android:installed}%"]]
install: [
  ["opam-installer" "--prefix=%{prefix}%/android-sysroot" "fmt.install"]
]
remove: [["ocamlfind" "-toolchain" "android" "remove" "fmt"]]

url {
  src: "https://erratique.ch/software/fmt/releases/fmt-0.11.0.tbz"
  checksum:
