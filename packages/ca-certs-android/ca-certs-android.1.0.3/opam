  "dune" {>= "2.0"}
  "bos-android"
  "fpath-android"
  "ptime-android"
  "logs-android"
  "digestif-android" {>= "1.2.0"}
  "mirage-crypto-android" {>= "1.0.0"}
  "x509-android" {>= "1.0.0"}
  "ocaml-android"
  "ohex-android" {>= "0.2.0"}
]
conflicts: [
  "result" {< "1.5"}
]

depexts: ["ca_root_nss"] {os = "freebsd" | os = "dragonfly"}
