  ["dune" "build" "-p" "ca-certs" "-j" jobs "-x" "android" "@install"]
  ["rm" "%{name}%.install"]
]
install: ["dune" "install" "-x" "android" "-p" "ca-certs"]
remove: ["ocamlfind" "-toolchain" "android" "remove" "ca-certs"]

