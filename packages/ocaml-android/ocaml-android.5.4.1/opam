# Android is ELF/Linux, so none of the Windows cross-compilation apparatus
# applies: no flexdll, no PE. This is upstream's own cross support.
#
# The NDK gives clang a triple-and-API prefix but leaves the binutils
# unprefixed, hence the two different sources for CC and AR/RANLIB.
#
# --disable-function-sections: configure enables it for an ELF target, but a
# macOS host builds its own tools with the target's OPTCOMPFLAGS, and a macOS
# ocamlopt has no such support ("OCaml has been configured without support for
# -function-sections"). Costs only --gc-sections dead-code trimming.
patches: ["no-pthread-cancel.patch"]
build: [
  [ "./configure"
    "--target=%{conf-ndk-android:host}%"
    "--prefix=%{prefix}%/android-sysroot"
    "--without-zstd"
    "--enable-systhreads"
    "--disable-function-sections"
    "CC=%{conf-ndk-android:prefix}%clang"
    "AR=%{conf-ndk-android:bindir}%/llvm-ar"
    "RANLIB=%{conf-ndk-android:bindir}%/llvm-ranlib"
    # The host strip has no aarch64 support on some distributions, and the
    # stdlib build strips an executable it has just cross-compiled.
    "STRIP=%{conf-ndk-android:bindir}%/llvm-strip"
    "-C"
    "--with-afl" {ocaml-option-afl:installed}
    "--disable-flat-float-array" {ocaml-option-no-flat-float-array:installed}
    "--enable-flambda" {ocaml-option-flambda:installed}
    "--enable-frame-pointers" {ocaml-option-fp:installed}
    "--enable-tsan" {ocaml-option-tsan:installed}
    "--disable-warn-error"
  ]
  [make "-j%{jobs}%" "crossopt"]
  # Copied rather than printf'd: the content passes through opam's string
  # parser and then the shell's, and the quoting does not survive both.
  # opam treats a files/<pkg>.install as the manifest itself and refuses it as
  # an extra-file, hence the rename here.
  ["cp" "install-manifest" "ocaml-android.install"]
]
install: [
  [make "installcross"]
  # <host>-ocamlc and friends, for tools that look for a triple-prefixed compiler
  ["sh" "./install.sh" "%{prefix}%" "%{conf-ndk-android:host}%"]
]
remove: [["sh" "./remove.sh" "%{prefix}%" "%{conf-ndk-android:host}%"]]
url {
  src: "https://github.com/ocaml/ocaml/releases/download/5.4.1/ocaml-5.4.1.tar.gz"
