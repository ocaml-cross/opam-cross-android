opam-version: "2.0"
maintainer: "Romain Beauxis <toots@rastageeks.org>"
authors: ["Antoine Miné" "Xavier Leroy" "Pascal Cuoq"]
homepage: "https://github.com/ocaml/Zarith"
bug-reports: "https://github.com/ocaml/Zarith/issues"
dev-repo: "git+https://github.com/ocaml/Zarith.git"
license: "LGPL-2.0-only WITH OCaml-LGPL-linking-exception"
synopsis: "Arbitrary-precision integers for Android targets"
description: """
zarith's configure drives the C compiler through `ocamlc -ccopt`, so putting
the cross compiler's bin directory first on PATH is what selects the NDK
toolchain — -prefixnonocaml does not apply here, since the NDK ships
llvm-ar rather than a triple-prefixed one.

Its probes only compile and stat the result, never running it, so they are
safe to cross-compile."""
depends: [
  "ocaml-android"
  "ocamlfind"
  "conf-pkg-config"
  "conf-gmp-android"
]
# Set through `env` rather than build-env: opam's PATH update does not reach
# configure, which finds `ocamlc` on PATH and drives the C compiler through
# `ocamlc -ccopt`. PKG_CONFIG_LIBDIR *replaces* the search path — PKG_CONFIG_PATH
# only prepends, and pkg-config then still resolves gmp to the host's Homebrew
# copy and links a macOS library into an Android build.
build-env: [
  # zarith's configure records findlib's destdir, so the toolchain has to be
  # selected before it runs — otherwise it installs over the native zarith.
  [OCAMLFIND_TOOLCHAIN = "android"]
]
build: [
  # Assignments in front of the command rather than build-env or `env`: opam
  # keeps CFLAGS and LDFLAGS out of the build environment, so both arrive empty
  # by either of those routes. gmp has to be named -- the linker the cross
  # ocamlopt drives does not read LIBRARY_PATH, so -lgmp goes unresolved --
  # and PATH has to lead with the cross compiler, which configure takes from
  # `ocamlc -ccopt`.
  ["sh" "-c"
   "CFLAGS=-I%{prefix}%/android-sysroot/include LDFLAGS=-L%{prefix}%/android-sysroot/lib PATH=%{prefix}%/android-sysroot/bin:%{prefix}%/bin:/usr/bin:/bin ./configure"]
  ["env" "PATH=%{prefix}%/android-sysroot/bin:%{prefix}%/bin:/usr/bin:/bin" make]
]
install: [["env" "OCAMLFIND_TOOLCHAIN=android" make "install"]]
remove: [["ocamlfind" "-toolchain" "android" "remove" "zarith"]]
url {
  src: "https://github.com/ocaml/Zarith/archive/release-1.14.tar.gz"
  checksum: [
    "sha256=5db9dcbd939153942a08581fabd846d0f3f2b8c67fe68b855127e0472d4d1859"
    "sha512=8a7f3e82dfa5699c8dda54dd5398c712f3ac4fe04f5208d43d8ba198fb8152de5f91cbb59c15c0a4ba010d4dfcc79f52e405bdd0abbf2798167e9e4216bcb3dd"
  ]
}
